{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Degug blip3o (GPU 3)",
        "type": "python",
        "request": "launch",
        "program": "/opt/anaconda3/envs/blip3o/bin/torchrun",
        //"program": "${workspaceFolder}/blip3o/train/train_mem.py",
        "console": "integratedTerminal",
         
        "justMyCode": true,
        "env": {
          "CUDA_VISIBLE_DEVICES": "4",
          "PATH": "/usr/local/cuda-12.2/bin:/opt/gcc-11.4/bin:${env:PATH}",
          "LD_LIBRARY_PATH": "/usr/local/cuda-12.2/lib64:/opt/gcc-11.4/lib64:${env:LD_LIBRARY_PATH}",
          "CC": "/opt/gcc-11.4/bin/gcc",
          "CXX": "/opt/gcc-11.4/bin/g++",
          "HF_HOME": "/mnt/33t/cy/mllm_models/",
          "OUTPUT_FOLDER": "/mnt/33t/cy/ex1",
          "IMG_FOLDER": "/mnt/33t/cy/blip3o_dataset",
          "HF_ENDPOINT": "https://hf-mirror.com",
        },
        "args": [
          "--nproc_per_node=1",
          "--master_port=25001",
          "${workspaceFolder}/blip3o/train/train_mem.py",
          "--deepspeed", "./deepspeed_scripts/zero1.json",
          "--model_name_or_path", "/mnt/33t/cy/mllm_models/Qwen/Qwen3-0.6B",
          "--version", "qwen",
          "--data_type", "mix",
          "--image_folder", "/mnt/33t/cy/blip3o_dataset",
          "--vision_tower", "google/siglip2-so400m-patch16-512",
          "--freeze_backbone", "False",
          "--gen_vision_tower", "eva-clip-E-14-plus",
          "--gen_projector_type", "mlp2x_gelu",
          "--mm_projector_type", "mlp2x_gelu",
          "--mm_vision_select_layer", "-2",
          "--mm_use_im_start_end", "False",
          "--mm_use_im_patch_token", "False",
          "--bf16", "True",
          "--output_dir", "/mnt/33t/cy/ex1",
          "--num_train_epochs", "10",
          "--per_device_train_batch_size", "8",
          "--per_device_eval_batch_size", "4",
          "--gradient_accumulation_steps", "1",
          "--eval_strategy", "no",
          "--save_strategy", "steps",
          "--save_steps", "1000",
          "--save_total_limit", "1",
          "--learning_rate", "1e-4",
          "--weight_decay", "0.",
          "--warmup_ratio", "0.003",
          "--lr_scheduler_type", "cosine_with_min_lr",
          "--lr_scheduler_kwargs", "{\"min_lr\":1e-5}",
          "--model_max_length", "512",
          "--logging_steps", "1",
          "--tf32", "True",
          "--gradient_checkpointing", "True",
          "--dataloader_num_workers", "4",
          "--lazy_preprocess", "True",
          "--gen_pooling", "early_pool2d_4",
          "--n_query", "64",
          "--n_und_query", "0",
          "--report_to", "wandb",
          "--run_name", "blip3o_qwen3_siglip2"
        ],
        "python": "/opt/anaconda3/envs/blip3o/bin/python"
      }
    ]
  }
  